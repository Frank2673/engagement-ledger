#!/bin/sh
#
# 提交信息规范校验（Conventional Commits）
#
# 启用方式：node scripts/setup-hooks.mjs

msg_file="$1"
subject=$(head -n 1 "$msg_file")

# 允许 git 自动生成的合并/回滚提交
case "$subject" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .+'

if ! printf '%s' "$subject" | grep -Eq "$pattern"; then
  echo ""
  echo "✗ 提交信息不符合 Conventional Commits 规范"
  echo ""
  echo "  当前：$subject"
  echo ""
  echo "  格式：<type>(<scope>): <描述>"
  echo "  类型：feat fix docs style refactor perf test build ci chore revert"
  echo ""
  echo "  示例：feat(gate): 支持 CIDR 范围判定"
  echo "        fix(ledger): 修正 HMAC 校验时的密钥提示"
  echo "        docs: 补充外部锚定的操作方法"
  echo ""
  exit 1
fi

if [ ${#subject} -gt 100 ]; then
  echo "✗ 提交信息首行过长（${#subject} 字符，上限 100）"
  exit 1
fi

exit 0
